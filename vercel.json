{
  "framework": "vite",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://api.routeev.uy/sitemap.xml" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
